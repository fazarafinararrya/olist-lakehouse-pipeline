# Copy to .env and adjust. Never commit .env.

# --- Where the data lives -------------------------------------------------
SOURCE_DIR=data/source

# Local filesystem (default, no Docker needed)
LAKE_RAW=data/lake/raw
LAKE_SILVER=data/lake/silver
LAKE_GOLD=data/lake/gold
DQ_REPORT_DIR=data/reports

# MinIO (docker compose) -- uncomment to use S3-compatible storage locally
# LAKE_RAW=s3a://olist-raw
# LAKE_SILVER=s3a://olist-silver
# LAKE_GOLD=s3a://olist-gold
# S3_ENDPOINT_URL=http://minio:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# AWS S3 -- use the bucket names printed by `terraform output`
# LAKE_RAW=s3a://olist-<account-id>-raw
# LAKE_SILVER=s3a://olist-<account-id>-silver
# LAKE_GOLD=s3a://olist-<account-id>-gold
# AWS_REGION=ap-southeast-1
# (credentials come from the standard AWS chain: env vars or ~/.aws/credentials)

# --- Spark ---------------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=8
